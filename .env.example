# Grafana Admin Credentials
GF_SECURITY_ADMIN_PASSWORD=admin

# Traefik SSL Configuration
# Domain name for Grafana access (must have DNS pointing to this server)
GRAFANA_DOMAIN=grafana.example.com
# Email for Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# AWS / S3 Credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# S3 Storage Configuration
# For AWS: s3.us-east-1.amazonaws.com
# For MinIO (Local): host.docker.internal:9000 (Mac/Windows) or minio:9000 (if in same network)
S3_ENDPOINT=host.docker.internal:9000
S3_INSECURE=true
S3_FORCE_PATH_STYLE=true

# S3 Bucket Names
S3_LOKI_BUCKET_NAME=loki-logs
S3_TEMPO_BUCKET_NAME=tempo-traces
S3_MIMIR_BUCKET_NAME=mimir-metrics
