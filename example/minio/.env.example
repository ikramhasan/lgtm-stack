# TO USE MINIO:
# 1. Run 'docker compose up -d' in example/minio
# 2. Copy these variables to your root .env

# AWS Credentials (MinIO defaults)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# S3 Storage Configuration (Points to MinIO)
# Use host.docker.internal:9000 for Mac/Windows Docker
# Use minio:9000 if LGTM stack is in the SAME docker network as MinIO
S3_ENDPOINT=host.docker.internal:9000
S3_FORCE_PATH_STYLE=true

# S3 Bucket Names (Matching your manual setup in MinIO dashboard)
S3_LOKI_BUCKET_NAME=loki-logs
S3_TEMPO_BUCKET_NAME=tempo-traces
S3_MIMIR_BUCKET_NAME=mimir-metrics
